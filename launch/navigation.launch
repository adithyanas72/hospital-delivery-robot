<launch>
  <arg name="map_file" default="$(find hospital_delivery)/maps/hospital_map.yaml"/>

  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)"/>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="base_frame_id" value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="global_frame_id" value="map"/>
    <param name="initial_pose_x" value="0.0"/>
    <param name="initial_pose_y" value="0.0"/>
    <param name="initial_pose_a" value="0.0"/>
  </node>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find hospital_delivery)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find hospital_delivery)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find hospital_delivery)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find hospital_delivery)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find hospital_delivery)/config/base_local_planner_params.yaml" command="load"/>
  </node>
</launch>
